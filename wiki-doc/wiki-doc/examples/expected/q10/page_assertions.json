{
  "schema_version": 1,
  "contract": "claims-v1",
  "oracle": "facts.json",
  "require_actual_markdown_values": true,
  "mutations": [
    {
      "group": "formulas",
      "selector": {
        "expression": "h.hours / 8.0"
      },
      "field": "expression",
      "value": "h.hours",
      "id": "D08-lose-hour-normalization"
    },
    {
      "group": "conditions",
      "selector": {
        "expression": "h.user_id = p_uid AND h.on_date = p_date"
      },
      "field": "expression",
      "value": "true",
      "id": "D09-remove-essential-where"
    }
  ]
}
