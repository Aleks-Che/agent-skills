    "BVD:SVD:other": {"ini": "forbidden", "stg": "forbidden", "mtd": "forbidden", "core": "forbidden", "apt": "forbidden"},
    "SVD:BVD:other": {"ini": "forbidden", "stg": "forbidden", "mtd": "forbidden", "core": "forbidden", "apt": "allowed"},
    "SVD:SVD:other": {"ini": "forbidden", "stg": "unconfirmed", "mtd": "unconfirmed", "core": "unconfirmed", "apt": "allowed"},
    "SVD:SVD:same": {"ini": "unconfirmed", "stg": "unconfirmed", "mtd": "unconfirmed", "core": "unconfirmed", "apt": "unconfirmed"}
  }
