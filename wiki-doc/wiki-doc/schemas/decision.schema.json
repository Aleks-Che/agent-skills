{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publication decision v2",
  "description": "Final gate decision referencing the verified manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "page_id",
    "decision",
    "manifest_sha256",
    "validation_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "page_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "decision": {
      "type": "string",
      "enum": [
        "ready",
        "revise",
        "blocked"
      ]
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "validation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metrics": {
      "type": "object",
      "properties": {
        "coverage_percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "accuracy_percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "total_checks": {
          "type": "integer",
          "minimum": 0
        },
        "ok_count": {
          "type": "integer",
          "minimum": 0
        },
        "defect_count": {
          "type": "integer",
          "minimum": 0
        },
        "inconclusive_count": {
          "type": "integer",
          "minimum": 0
        },
        "not_applicable_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "blocking_defects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "blocking_inconclusive": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "validation_history": {"$ref": "#/$defs/validation_history"},
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "validation_history": {
      "type": "object",
      "required": ["schema_version", "run_id", "page_id", "complete", "attempts"],
      "properties": {
        "schema_version": {"const": 1},
        "run_id": {"type": "string", "minLength": 1},
        "page_id": {"type": "string", "minLength": 1},
        "complete": {"type": "boolean"},
        "attempts": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["decision", "recorded_at"],
            "properties": {
              "decision": {"enum": ["ready", "revise", "blocked"]},
              "recorded_at": {"type": "string", "format": "date-time"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
