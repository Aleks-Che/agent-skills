{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Facts registry v2",
  "description": "Registry of technical facts extracted from SQL/DDL analysis",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "dialect",
    "documented_object_ids",
    "inputs",
    "objects",
    "definitions",
    "operations",
    "columns",
    "formulas",
    "conditions",
    "unknowns"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "dialect": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "documented_object_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_ref_short"
      },
      "minItems": 1
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object_entry"
      },
      "minItems": 1
    },
    "definitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/definition_entry"
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operation_entry"
      }
    },
    "columns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/column_entry"
      }
    },
    "formulas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/formula_entry"
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/condition_entry"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unknown_entry"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source_ref": {
      "type": "object",
      "required": [
        "path",
        "start_line",
        "end_line",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "root": {
          "type": "string",
          "enum": [
            "project",
            "run",
            "wiki",
            "package"
          ]
        }
      },
      "additionalProperties": false
    },
    "source_ref_short": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "root": {
          "type": "string",
          "enum": [
            "project",
            "run",
            "wiki",
            "package"
          ]
        }
      },
      "additionalProperties": false
    },
    "object_entry": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "source_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "kind": {
          "type": "string",
          "enum": [
            "table",
            "view",
            "materialized_view",
            "function",
            "procedure",
            "migration",
            "cte",
            "temp_table",
            "ctas"
          ]
        },
        "schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "signature": {
          "type": [
            "string",
            "null"
          ]
        },
        "page_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        },
        "scope": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "physical": {
          "type": "boolean"
        },
        "canonical_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "cte",
                  "temp_table"
                ]
              }
            }
          },
          "then": {
            "required": [
              "scope",
              "physical"
            ],
            "properties": {
              "scope": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "physical": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "definition_entry": {
      "type": "object",
      "required": [
        "id",
        "object_id",
        "status",
        "source_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "object_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "type": "string",
          "enum": [
            "resolved",
            "not_found",
            "ambiguous",
            "external"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "migration_order": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "structure": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "resolved"
              }
            }
          },
          "then": {
            "properties": {
              "source_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "operation_entry": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "source_refs",
        "reads",
        "writes",
        "calls",
        "scope",
        "order",
        "condition_ids",
        "dynamic"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "kind": {
          "type": "string",
          "enum": [
            "SELECT",
            "INSERT",
            "UPDATE",
            "DELETE",
            "MERGE",
            "TRUNCATE",
            "CREATE",
            "ALTER",
            "DROP",
            "COMMENT",
            "GRANT",
            "REVOKE",
            "CTAS",
            "PERFORM",
            "CALL",
            "EXECUTE",
            "RETURN",
            "IF",
            "CASE",
            "LOOP",
            "RAISE",
            "ASSIGN",
            "OTHER"
          ]
        },
        "reads": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "writes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "calls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "condition_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "transforms": {
          "type": [
            "string",
            "null"
          ]
        },
        "dynamic": {
          "oneOf": [
            {
              "const": false
            },
            {
              "type": "object",
              "required": [
                "template",
                "unresolved_parts"
              ],
              "properties": {
                "template": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "unresolved_parts": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_ref"
          },
          "minItems": 1
        },
        "kind_detail": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "OTHER"
              }
            }
          },
          "then": {
            "required": [
              "kind_detail"
            ]
          }
        }
      ]
    },
    "column_entry": {
      "type": "object",
      "required": [
        "id",
        "object_id",
        "name",
        "type_target",
        "type_expression",
        "source_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "object_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "type_target": {
          "type": [
            "string",
            "null"
          ]
        },
        "type_expression": {
          "type": [
            "string",
            "null"
          ]
        },
        "expression": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "nullable": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "default": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "type_evidence": {
          "type": "object",
          "properties": {
            "type_target": {
              "type": "object",
              "required": [
                "kind",
                "source_refs"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "declaration",
                    "expression",
                    "comment",
                    "inferred"
                  ]
                },
                "source_refs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/source_ref"
                  }
                }
              },
              "additionalProperties": false
            },
            "type_expression": {
              "type": "object",
              "required": [
                "kind",
                "source_refs"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "declaration",
                    "expression",
                    "comment",
                    "inferred"
                  ]
                },
                "source_refs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/source_ref"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "type_target"
            ],
            "properties": {
              "type_target": {
                "type": "string"
              }
            }
          },
          "then": {
            "required": [
              "type_evidence"
            ],
            "properties": {
              "type_evidence": {
                "required": [
                  "type_target"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type_expression"
            ],
            "properties": {
              "type_expression": {
                "type": "string"
              }
            }
          },
          "then": {
            "required": [
              "type_evidence"
            ],
            "properties": {
              "type_evidence": {
                "required": [
                  "type_expression"
                ]
              }
            }
          }
        }
      ]
    },
    "formula_entry": {
      "type": "object",
      "required": [
        "id",
        "expression",
        "source_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "expression": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "used_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "condition_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "operation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_ref"
          },
          "minItems": 1
        },
        "column_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "condition_entry": {
      "type": "object",
      "required": [
        "id",
        "expression",
        "source_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "expression": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "operation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_ref"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "unknown_entry": {
      "type": "object",
      "required": [
        "id",
        "what",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "what": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "related_facts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "impact": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
