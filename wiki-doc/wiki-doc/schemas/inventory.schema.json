{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SQL inventory v2",
  "description": "Independent SQL/DDL analysis without reading facts.json or draft",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "dialect",
    "items",
    "inputs",
    "documented_subjects"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "dialect": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inventory_item"
      },
      "minItems": 1
    },
    "coverage_notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage_note"
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "root": {
            "type": "string",
            "enum": [
              "project",
              "run",
              "wiki",
              "package"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "documented_subjects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true,
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "inventory_item": {
      "type": "object",
      "required": [
        "anchor",
        "kind",
        "source_ref"
      ],
      "properties": {
        "anchor": {
          "type": "object",
          "required": [
            "object_or_scope",
            "construct",
            "ordinal"
          ],
          "properties": {
            "object_or_scope": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "construct": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "ordinal": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_ref": {
          "type": "object",
          "required": [
            "path",
            "start_line",
            "end_line",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "start_line": {
              "type": "integer",
              "minimum": 1
            },
            "end_line": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "root": {
              "type": "string",
              "enum": [
                "project",
                "run",
                "wiki",
                "package"
              ]
            }
          },
          "additionalProperties": false
        },
        "reads": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "writes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "calls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "details": {
          "type": "object",
          "properties": {
            "extension_version": {
              "const": 1
            },
            "constraints": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "type",
                  "ddl"
                ],
                "properties": {
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "type": {
                    "type": "string"
                  },
                  "ddl": {
                    "type": "string"
                  },
                  "columns": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "referenced_table": {
                    "type": "string"
                  },
                  "referenced_columns": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "expression": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "dependentRequired": {
            "constraints": [
              "extension_version"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "coverage_note": {
      "type": "object",
      "required": [
        "source_ref",
        "reason"
      ],
      "properties": {
        "source_ref": {
          "type": "object",
          "required": [
            "path",
            "start_line",
            "end_line",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "start_line": {
              "type": "integer",
              "minimum": 1
            },
            "end_line": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "root": {
              "type": "string",
              "enum": [
                "project",
                "run",
                "wiki",
                "package"
              ]
            }
          },
          "additionalProperties": false
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    }
  }
}
