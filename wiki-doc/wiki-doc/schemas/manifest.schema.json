{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run manifest v2",
  "description": "Manifest of all inputs and artifacts for a documentation run",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "sql_files",
    "tool_versions",
    "page_id",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "sql_files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file_ref"
      },
      "minItems": 1
    },
    "context_files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file_ref"
      }
    },
    "migration_manifest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/file_ref"
        }
      ]
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "facts": {
          "$ref": "#/$defs/artifact_ref"
        },
        "inventory": {
          "$ref": "#/$defs/artifact_ref"
        },
        "validation_plan": {
          "$ref": "#/$defs/artifact_ref"
        },
        "coverage": {
          "$ref": "#/$defs/artifact_ref"
        },
        "draft": {
          "$ref": "#/$defs/artifact_ref"
        },
        "validation": {
          "$ref": "#/$defs/artifact_ref"
        }
      },
      "additionalProperties": false,
      "required": [
        "facts",
        "inventory",
        "validation_plan",
        "coverage",
        "draft",
        "validation"
      ]
    },
    "tool_versions": {
      "type": "object",
      "properties": {
        "scripts_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "skill_md_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "template_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "scripts_sha256",
        "skill_md_sha256",
        "template_sha256",
        "policy_sha256"
      ]
    },
    "page_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "identity_registry": {
      "$ref": "#/$defs/file_ref"
    },
    "documented_subjects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "file_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "root": {
          "type": "string",
          "enum": [
            "project",
            "run",
            "wiki",
            "package"
          ]
        }
      },
      "additionalProperties": false
    },
    "artifact_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "root": {
          "type": "string",
          "enum": [
            "project",
            "run",
            "wiki",
            "package"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
