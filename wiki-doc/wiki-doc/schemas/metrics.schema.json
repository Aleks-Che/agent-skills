{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wiki documentation quality metrics v1",
  "description": "Aggregated quality metrics derived from published wiki bundles, lint results and regression runs. Each ratio defines its denominator; a skipped run never counts as success.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "period",
    "pages",
    "fresh_sources",
    "full_coverage",
    "first_pass_success",
    "blocking_defects",
    "open_unknowns",
    "outdated_pages",
    "broken_links",
    "erroneous_ready",
    "average_iterations"
  ],
  "properties": {
    "period": {
      "type": "object",
      "required": ["wiki", "validation", "validation_start", "validation_end", "regression"],
      "properties": {
        "wiki": {"const": "current_published_snapshot"},
        "validation": {"const": "current_published_runs"},
        "validation_start": {"type": ["string", "null"], "format": "date-time"},
        "validation_end": {"type": ["string", "null"], "format": "date-time"},
        "regression": {"const": "supplied_mutation_report"}
      },
      "additionalProperties": false
    },
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp of metrics computation"
    },
    "pages": {
      "type": "object",
      "description": "Page counts by status",
      "required": ["managed", "legacy", "total"],
      "properties": {
        "managed": { "type": "integer", "minimum": 0 },
        "legacy": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "fresh_sources": {
      "type": "object",
      "description": "Ratio of managed pages whose source hashes match disk",
      "required": ["numerator", "denominator", "percent", "stale_pages"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 0, "description": "Pages with current source hashes" },
        "denominator": { "type": "integer", "minimum": 0, "description": "Total managed pages" },
        "percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "100 * numerator / denominator; null if denominator is 0" },
        "stale_pages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["page_id", "reason"],
            "properties": {
              "page_id": { "type": "string" },
              "reason": { "type": "string" },
              "path": { "type": "string" }
            },
            "additionalProperties": false
          },
          "description": "Pages with stale or missing sources"
        }
      },
      "additionalProperties": false
    },
    "full_coverage": {
      "type": "object",
      "description": "Ratio of managed pages with 100% fact coverage",
      "required": ["numerator", "denominator", "percent", "incomplete_pages"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 0 },
        "percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "incomplete_pages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["page_id", "coverage_percent"],
            "properties": {
              "page_id": { "type": "string" },
              "coverage_percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "first_pass_success": {
      "type": "object",
      "description": "First issuing gate attempt in each current published run; null percent if any page lacks complete history",
      "required": ["numerator", "denominator", "percent", "multi_pass_pages", "measured", "measured_pages", "unmeasured_pages"],
      "properties": {
        "measured": {"type": "boolean"},
        "measured_pages": {"type": "integer", "minimum": 0},
        "unmeasured_pages": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "numerator": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 0 },
        "percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "multi_pass_pages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["page_id", "iterations"],
            "properties": {
              "page_id": { "type": "string" },
              "iterations": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "blocking_defects": {
      "type": "object",
      "description": "Total blocking defects across all managed pages",
      "required": ["total", "by_page"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "by_page": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["page_id", "count", "defect_ids"],
            "properties": {
              "page_id": { "type": "string" },
              "count": { "type": "integer", "minimum": 0 },
              "defect_ids": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "open_unknowns": {
      "type": "object",
      "description": "Documented facts.unknowns plus inconclusive validation checks in current published bundles; IDs prefixed with fact: or check:",
      "required": ["total", "by_page"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "by_page": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["page_id", "count", "unknown_ids"],
            "properties": {
              "page_id": { "type": "string" },
              "count": { "type": "integer", "minimum": 0 },
              "unknown_ids": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "outdated_pages": {
      "type": "object",
      "description": "Pages whose tracked source files differ from disk (query --outdated)",
      "required": ["total", "pages"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["page_id", "reason"],
            "properties": {
              "page_id": { "type": "string" },
              "reason": { "type": "string" },
              "path": { "type": "string" },
              "source_missing": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "broken_links": {
      "type": "object",
      "description": "Broken relative links found by lint",
      "required": ["total", "by_page"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "by_page": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["page_id", "count", "links"],
            "properties": {
              "page_id": { "type": "string" },
              "count": { "type": "integer", "minimum": 0 },
              "links": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "erroneous_ready": {
      "type": "object",
      "description": "Share of labeled defects that received 'ready' (target: 0 on the labeled test set). A missing or empty regression report is unmeasured, never a successful zero.",
      "required": ["numerator", "denominator", "percent", "measured", "cases"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 0, "description": "Labeled defects that wrongly received 'ready'" },
        "denominator": { "type": "integer", "minimum": 0, "description": "Mutation results evaluated in the regression report" },
        "percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "100 * numerator / denominator; null when no run was measured" },
        "measured": { "type": "boolean", "description": "True only for a nonempty report in which every labeled mutation was evaluated; skipped/error/unevaluated results keep percent null" },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["case_id", "page_id", "mutation", "decision"],
            "properties": {
              "case_id": { "type": "string" },
              "page_id": { "type": "string" },
              "mutation": { "type": "string" },
              "decision": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "average_iterations": {
      "type": ["number", "null"],
      "minimum": 0,
      "description": "Mean of 1 + failed issuing gate attempts in each current published run; successful rechecks/publication retries do not add corrections. Null if no pages or any history is missing."
    }
  },
  "additionalProperties": false
}
