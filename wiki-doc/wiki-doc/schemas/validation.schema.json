{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validation report v2",
  "description": "Results of checking facts and draft against SQL/DDL",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "page_id",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "page_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check_entry"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "check_entry": {
      "type": "object",
      "required": [
        "id",
        "status",
        "blocking",
        "reason",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "defect",
            "inconclusive",
            "not_applicable"
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "category": {
          "type": "string",
          "enum": [
            "technical",
            "editorial"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "object",
                "required": [
                  "root",
                  "path",
                  "start_line",
                  "end_line",
                  "sha256"
                ],
                "properties": {
                  "root": {
                    "type": "string",
                    "enum": [
                      "project",
                      "run",
                      "wiki",
                      "package"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "start_line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "end_line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "plan_check_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "defect_code": {
          "type": "string",
          "minLength": 1
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "ok",
                  "defect"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
